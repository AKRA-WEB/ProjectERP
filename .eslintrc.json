{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "plugins": ["local-rules"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "no-empty": ["error", { "allowEmptyCatch": false }],
    "local-rules/no-hardcoded-thai": "error",
    "local-rules/no-unbounded-query": "error"
  }
}
