# ─── Local Development ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/wms_db
NEXTAUTH_SECRET=your-secret-here-min-32-chars
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development

# ─── Vercel Production (Supabase) ────────────────────────────────────────────
# Use Transaction Pooler URL (port 6543) for API routes — set in Vercel dashboard
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# NEXTAUTH_SECRET=<openssl rand -base64 32>
# NEXTAUTH_URL=https://your-app.vercel.app
# NODE_ENV=production

# ─── Migration only (use Session Pooler port 5432 or Direct connection) ──────
# Run: DATABASE_URL=<session-url> npm run migrate
