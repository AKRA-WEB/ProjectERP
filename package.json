    "eslint-plugin-local-rules": "^3.0.2",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.7",
    "xlsx": "^0.18.5"
  }
