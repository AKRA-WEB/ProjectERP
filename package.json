    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "csv-stringify": "^6.7.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.14.0",
    "next": "15.3.8",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
